	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Table.Distinct(
				        Table.SelectColumns(
				            Staging_Sales,
				            {"item", "category"}
				        )
				    ),
				    Sorted = Table.Sort(
				        Source,
				        {
				            {"category", Order.Ascending},
				            {"item", Order.Ascending}
				        }
				    )
				in
				    Sorted

	annotation PBI_NavigationStepName = Navigation

